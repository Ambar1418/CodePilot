# CodePilot Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Your Groq API key (https://console.groq.com)
GROQ_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero infrastructure):
DATABASE_URL=sqlite:///./codepilot.db
# PostgreSQL (optional, requires pg running):
# DATABASE_URL=postgresql://user:password@localhost:5432/codepilot

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a secure random string:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Repository Safety ─────────────────────────────────────────────────────────
# If set, only repositories under this path are allowed.
# Leave empty to allow any path (development only).
# REPOSITORY_BASE_DIR=/home/user/projects

# ── Sandbox ───────────────────────────────────────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_DOCKER_IMAGE=python:3.13-slim

# ── Orchestration ─────────────────────────────────────────────────────────────
MAX_DEBUG_ATTEMPTS=3
WORKTREE_BASE_DIR=/tmp/codepilot-worktrees

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO